      <string>com.apple.mdm</string>
      <key>PayloadUUID</key>
      <string>11111111-2222-4333-8444-555555555555</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>AccessRights</key>
      <integer>8191</integer>
      <key>CheckInURL</key>
      <string>https://admin-device-management.vercel.app/api/mdm/checkin</string>
      <key>ServerURL</key>
      <string>https://admin-device-management.vercel.app/api/mdm/connect</string>
      <key>SignMessage</key>
      <true/>
      <key>Topic</key>
      <string>com.apple.mgmt.External.placeholder</string>
