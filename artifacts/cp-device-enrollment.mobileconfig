    <dict>
      <key>PayloadDescription</key>
      <string>Configures CP DEVICE MDM enrollment. Configures CP DEVICE MDM enrollment. This profile must be signed and completed with production Apple MDM APNs Topic and identity certificate values before iPhone fleet deployment.</string>
